# Yams through its Xcode project and xcodebuild, on this Mac (README, "The targets"). Sourced by slow-acceptance.sh.
# yams-swiftpm runs the same pin through `swift test`.
REPO=https://github.com/jpsim/Yams.git
# Yams's main at #482's merge (2026-05-26).
PIN=df801bc4f158f107035d2e14f6d0d8d31eb31ddb
REFERENCE_STEM=yams-xcodebuild-$PIN
PINS_PACKAGES=no
# On a Mac destination, SwiftMutator tests one mutant at a time.
WORKERS=1

BUILD_SYSTEM=xcodebuild
# - UTF8 only, of the test plan's two configurations: as yams-swiftpm's tests run, in half the time.
# - Parallel testing off, though the test plan allows it, so each failed test's line is its own.
# - Debug, though the scheme tests in Release, as `swift test` builds; the release scenario takes the scheme's Release.
# - CI=true skips the project's SwiftLint build phase. Xcode 27 builds for macOS 12 at the least, and the project
#   says 10.13.
XCODEBUILD_ARGUMENTS=(
  -project Yams.xcodeproj -scheme Yams -destination 'platform=macOS,arch=arm64' -only-test-configuration UTF8
  -parallel-testing-enabled NO -configuration Debug CI=true MACOSX_DEPLOYMENT_TARGET=12.0
)
XCODEBUILD_RELEASE_ARGUMENTS=(
  -project Yams.xcodeproj -scheme Yams -destination 'platform=macOS,arch=arm64' -only-test-configuration UTF8
  -parallel-testing-enabled NO -configuration Release CI=true MACOSX_DEPLOYMENT_TARGET=12.0
)

OPERATORS=(
  ChangeArithmeticOperator
  ChangeLogicalConnector
  FlipBooleanLiteral
  NegateConditional
  RelationalBoundary
  RelationalOperatorReplacement
  RemoveSideEffects
  ReplaceBooleanValue
  ReplaceReturnValue
  SwapTernary
)

# Each an -skip-testing identifier: Target/Class/test.
SKIP_TESTS=(
  # It round-trips the current time, so whether it kills a date-formatting mutant depends on the clock.
  YamsTests/EncoderTests/testEncodingDate
)

TEST_FILES_GLOB='Tests/YamsTests/*Tests.swift'
NOT_APPLICABLE=(
  'no-stop: stopAtFirstFailure works only with `swift test`'
  'reuse-testchange: XCTest kills never hold after a test change under either build system, which yams-swiftpm checks; here its two runs would take as long as two full runs'
)

# reuse-sourcechange appends a comment to this file: no mutants, and no test reads it.
SOURCE_CHANGE_FILE=Sources/Yams/YamlTagProviding.swift
