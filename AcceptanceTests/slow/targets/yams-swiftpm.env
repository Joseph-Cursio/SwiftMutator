# Yams through `swift test`: a SwiftPM package whose tests are XCTest (README, "The targets"). Sourced by
# slow-acceptance.sh. yams-xcodebuild runs the same pin through its Xcode project.
REPO=https://github.com/jpsim/Yams.git
# Yams's main at #482's merge (2026-05-26).
PIN=df801bc4f158f107035d2e14f6d0d8d31eb31ddb
REFERENCE_STEM=yams-swiftpm-$PIN
# No dependencies, so no Package.resolved to keep.
PINS_PACKAGES=no
WORKERS=4

OPERATORS=(
  ChangeArithmeticOperator
  ChangeLogicalConnector
  FlipBooleanLiteral
  NegateConditional
  RelationalBoundary
  RelationalOperatorReplacement
  RemoveSideEffects
  ReplaceBooleanValue
  ReplaceReturnValue
  SwapTernary
)

# `swift test --skip` takes a regular expression, matched against Module.Class/test.
SKIP_TESTS=(
  # It round-trips the current time, so whether it kills a date-formatting mutant depends on the clock.
  'EncoderTests/testEncodingDate$'
)

# XCTest runs the methods named test…: reuse-testchange renames them. Its kills name no file, so SwiftMutator tests
# every kill again after a test change, which the scenario checks.
TEST_CHANGE_EDIT=xctest
TEST_FILES_GLOB='Tests/YamsTests/*Tests.swift'

# Chosen when the reference is made (README).
# reuse-testchange disables this file's tests: the classes it declares alone killed some mutants (54 in the
# reference), and no other file shares its name.
TEST_CHANGE_FILE=Tests/YamsTests/ConstructorTests.swift
# reuse-sourcechange appends a comment to this file: no mutants, and no test reads it.
SOURCE_CHANGE_FILE=Sources/Yams/YamlTagProviding.swift
# since runs --since this ref --changed-lines: its diff requires 20 or more mutants, in 2 or more files. This one,
# the 6.0.2 changelog commit (2025-06-23), 24 commits before the pin on main, requires 23 in 5 files, the fewest of
# any that qualifies.
SINCE_BASE=293100b16b3f1e21f2cadf2dabffb2747aea6090
