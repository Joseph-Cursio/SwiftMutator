# The slow acceptance tier's target, sourced by slow-acceptance.sh. Changing PIN needs a new reference (README).

REPO=https://github.com/Joseph-Cursio/SwiftProjectLint.git
# SwiftProjectLint's main once its tests' run-to-run differences were fixed (SwiftProjectLint#324).
PIN=b674e29a5d9ffbe683249d184f39a834f7f86bc9
WORKERS=4

EXCLUDES=(
  # 2,952 of the pin's 3,823 mutants: a whole run of them all takes about 6 h. The other 871, in the engine, visitors,
  # config, app and CLI, take the scenarios through every whole-run behaviour they check.
  'Packages/SwiftProjectLintRules/**'
  # A mutant in either would break the baseline: tests parse them from disk through #filePath.
  '**/BuiltInRules.swift'
  '**/PatternCategory.swift'
)
# Tests the mutated copy fails whatever the mutant: skipped (`swift test --skip`) rather than their sources
# excluded, which would leave those files' mutants out.
SKIP_TESTS=(
  # These two parse the copy's sources, whose switches repeat each mutated statement in every arm.
  'cliBuildsItsLinterOnlyThroughMakeLinter'
  'prescanWithholdsEveryOracleBuiltCatalog'
  # A 20-link inspect() chain, whose recursion overflows a test thread's stack once the switches enlarge each frame
  # (SIGBUS, ending the whole CoreTests run).
  'reinspectionIsLinear'
)

# Chosen when the reference is made (README).
# reuse-testchange disables this file's suites: its tests alone killed some mutants (52 in the reference), and no
# other file shares its name.
TEST_CHANGE_FILE=Tests/CoreTests/Configuration/DefaultIsolationDetectorTests.swift
# reuse-sourcechange appends a comment to this file: no mutants, and no test reads it.
SOURCE_CHANGE_FILE=Packages/SwiftProjectLintVisitors/Sources/SwiftProjectLintVisitors/TypeCollectorProtocol.swift
# since runs --since this ref --changed-lines: its diff requires 20 or more mutants, in 2 or more files. This one,
# SwiftProjectLint#309's merge, 14 merges before the pin, requires 27 in 7 files, the fewest of any that qualifies.
SINCE_BASE=920284821d0da7000552f85433f0528296d1f8eb
